<?xml version="1.0"?>
<robot name="devotics_arm">
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.10" length="0.10"/>
            </geometry>
            <material name="base_color">
                <color rgba="0.2 0.2 0.2 1"/>
            </material>
        </visual>
    </link>
    <link name="arm_link">
        <visual>
            <origin xyz="0 0 0.20" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.08 0.40"/>
            </geometry>
            <material name="arm_color">
                <color rgba="0.1 0.4 0.8 1"/>
            </material>
        </visual>
    </link>
    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="arm_link"/>
        <origin xyz="0 0 0.10" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit
            lower="-1.57"
            upper="1.57"
            effort="10"
            velocity="1.0"
        />
    </joint>
</robot>
